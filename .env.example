# PTP Soccer App Environment Variables
# Copy this file to .env and fill in your values
#
# For Production Deployment:
# 1. Copy this file: cp .env.example .env
# 2. Update all placeholder values below
# 3. Run: eas build --platform all --profile production

# ===========================================
# API CONFIGURATION (Required)
# ===========================================

# WordPress API Base URL (your backend server)
# This should be your production WordPress site URL
API_BASE_URL=https://ptpsummercamps.com

# API Namespace for PTP endpoints
# v2 is the current version with training platform support
MOBILE_API_NAMESPACE=/wp-json/ptp/v2

# ===========================================
# DEMO MODE (Required)
# ===========================================
# Controls whether the app uses mock data or real API
#
# true  = Uses mock data (for development, App Store review)
# false = Uses live WordPress API (for production)
#
# Note: EAS build profiles override this value:
# - development/development:device -> DEMO_MODE=true
# - preview/production -> DEMO_MODE=false
DEMO_MODE=false

# ===========================================
# STRIPE PAYMENT PROCESSING (Required for Payments)
# ===========================================
# Get your keys from: https://dashboard.stripe.com/apikeys
#
# Testing: Use pk_test_* keys
# Production: Use pk_live_* keys
#
# The EXPO_PUBLIC_ prefix makes this available on the client side
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY

# ===========================================
# EXPO / EAS CONFIGURATION
# ===========================================

# EAS Project ID (already configured in app.config.js)
# Only change if you need to override
# EXPO_PUBLIC_PROJECT_ID=68d2492c-c447-441d-8bf3-99413f385ed4

# ===========================================
# APP VARIANT (for development builds)
# ===========================================
# Options: development, preview, production
# Set automatically by EAS build profiles
# APP_VARIANT=production

# ===========================================
# FIREBASE / PUSH NOTIFICATIONS (Android Only)
# ===========================================
# Download google-services.json from Firebase Console:
# 1. Go to Firebase Console > Project Settings > Your apps
# 2. Download google-services.json
# 3. Place in project root
# 4. Set path below (default: ./google-services.json)
# GOOGLE_SERVICES_JSON=./google-services.json
