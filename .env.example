# PTP Soccer App Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# API CONFIGURATION
# ===========================================

# WordPress API Base URL (your backend)
API_BASE_URL=https://ptpsummercamps.com

# API Namespace for PTP endpoints
MOBILE_API_NAMESPACE=/wp-json/ptp/v1

# ===========================================
# DEMO MODE
# ===========================================
# Set to 'true' to use mock data without a backend connection
# Set to 'false' for production (requires working WordPress backend)
DEMO_MODE=false

# ===========================================
# EXPO / EAS CONFIGURATION (Required for Production)
# ===========================================

# EAS Project ID - Get this from https://expo.dev after creating your project
# Required for: Push notifications, OTA updates, EAS Build
# To get your project ID:
# 1. Run: npx eas-cli init
# 2. Or find it at: https://expo.dev/accounts/[your-account]/projects/[your-project]
EXPO_PUBLIC_PROJECT_ID=

# ===========================================
# APP VARIANT (for development builds)
# ===========================================
# Options: development, preview, production (default)
# APP_VARIANT=development
