# PTP Soccer App Environment Variables
# Copy this file to .env and fill in your values

# WordPress API Configuration
API_BASE_URL=https://ptpsummercamps.com
MOBILE_API_NAMESPACE=/wp-json/ptp/v1

# Demo Mode (set to 'true' to use mock data without backend)
DEMO_MODE=true

# Push Notifications (optional - for production)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id
