# EAS Build ignore file
# IMPORTANT: package-lock.json MUST be included for npm to be used

# Explicitly include the lockfile (negate any potential ignore)
!package-lock.json
!package.json

# Ignore development files
.git
.github
.vscode

# Ignore documentation (except README)
*.md
!README.md

# Ignore test files
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage

# Ignore local environment files
.env.local
.env.development

# Ignore IDE files
.idea
*.swp
*.swo

# Ignore large unnecessary files
*.zip
PTP_iOS_Audit.md
wordpress-plugin
