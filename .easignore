# EAS Build Ignore File
# Excludes files from being uploaded to EAS Build

# Windows user profile folders
AppData/
AppData/**
Downloads/
Documents/
Desktop/
Pictures/
Videos/
Music/

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini
*.tmp
*.temp
*.bak

# Browser caches
**/Cache/**
**/Cache_Data/**
**/Code Cache/**

# Sessions and temp
**/Sessions/**

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Git internals
.git/

# Test outputs
coverage/
__tests__/

# Documentation (not needed for build)
docs/

# Development configs
.env
.env.local
.env.*.local
